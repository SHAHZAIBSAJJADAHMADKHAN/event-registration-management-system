# Browser-safe values only. Do not place backend secrets in this file.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Vercel production uses the same-origin FastAPI service.
VITE_API_BASE_URL=/api
# For local development, set ignored frontend/.env to:
# VITE_API_BASE_URL=http://localhost:8000
